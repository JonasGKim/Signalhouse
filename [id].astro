---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getResearch, getResearchBody } from '../../../lib/server/notion';
import { tickerSlug } from '../../../data/research';
import { formatResearchDate } from '../../../lib/formatting';
import ResearchBlocks from '../../../components/projects/nfa/ResearchBlocks.astro';
const library = await getResearch();
const entry = library.entries.find((e) => e.id === Astro.params.id);
const body = entry
  ? await getResearchBody(entry.id)
  : { blocks: [], available: false };
Astro.response.status = library.status !== 'ready' ? 503 : entry ? 200 : 404;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout
  title={entry?.title || 'Research note'}
  description={entry?.thesis || 'Independent research from Signal House.'}
>
  <article class="container page-content reading-page">
    <a class="text-link" href="/research/">← Research Desk</a>
    {
      entry ? (
        <>
          <header class="reading-heading">
            <>
              <p class="eyebrow">
                Not Financial Advice{' '}
                {entry.ticker && (
                  <>
                    {' '}
                    /{' '}
                    <a href={`/research/${tickerSlug(entry.ticker)}/`}>
                      {entry.ticker}
                    </a>
                  </>
                )}
              </p>
              <h1>{entry.title}</h1>
              <p class="reading-company">{entry.company}</p>
              <div class="reading-meta">
                <time datetime={entry.publishedAt}>Recorded {formatResearchDate(entry.publishedAt)}</time>
                <time datetime={entry.updatedAt}>
                  Edited {formatResearchDate(entry.updatedAt)}
                </time>
                {entry.categories.map((c) => (
                  <span>{c}</span>
                ))}
                {entry.conviction && (
                  <span>Conviction: {entry.conviction}</span>
                )}
              </div>
            </>
          </header>
          <div class="reading-body">
            {entry.notes && <p class="reading-lead">{entry.notes}</p>}
            <ResearchBlocks blocks={body.blocks} />
            {entry.sources.length > 0 && (
              <section>
                <h2>References</h2>
                <ul>
                  {entry.sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noopener noreferrer">
                        {source.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
            {!body.available && (
              <p role="status">
                The full entry couldn’t be loaded.{' '}
                <a href={Astro.url.pathname}>Try again</a>.
              </p>
            )}
          </div>
          <footer class="reading-end">
            <p>Independent research · Not investment advice</p>
            {entry.ticker && (
              <a
                class="text-link"
                href={`/research/${tickerSlug(entry.ticker)}/`}
              >
                Follow the {entry.ticker} research history
              </a>
            )}
          </footer>
        </>
      ) : (
        <div class="page-heading">
          <>
            <h1>
              {library.status !== 'ready'
                ? 'Research unavailable.'
                : 'Note not found.'}
            </h1>
            <p>Please return to the Research Desk.</p>
          </>
        </div>
      )
    }
  </article></BaseLayout
>
