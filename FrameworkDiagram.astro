---
const stages = [
  {
    number: '01',
    title: 'Data',
    question: 'Public economic and company information.',
    href: '/methodology/',
  },
  {
    number: '02',
    title: 'Tools',
    question: 'Different questions. A shared analytical workspace.',
    href: '/#tools',
  },
  {
    number: '03',
    title: 'Signals',
    question: 'Context drawn from clearly defined inputs.',
    href: '/macro/',
  },
  {
    number: '04',
    title: 'Research',
    question: 'Written observations, open to re-examination.',
    href: '/research/',
  },
];
---

<section class="framework" aria-labelledby="framework-title">
  <div class="container">
    <div class="framework-heading">
      <p class="eyebrow">The platform, connected</p><h2 id="framework-title">
        A process for forming a view.
      </h2><p>Keep the evidence close.<br />Make the assumptions visible.</p>
    </div><ol class="framework-stages">
      {
        stages.map((stage) => (
          <li>
            <a href={stage.href}>
              <>
                <div class="stage-track">
                  <>
                    <span class="mono">{stage.number}</span>
                    <i aria-hidden="true" />
                  </>
                </div>
                <h3>{stage.title}</h3>
                <p>{stage.question}</p>
              </>
            </a>
          </li>
        ))
      }
    </ol><div class="framework-closing">
      <p>Understand the source before relying on the signal.</p><a
        class="text-link"
        href="/methodology/">Methodology & sources</a>
    </div>
  </div>
</section>
