---
import { projects } from '../../data/projects';
import ProjectRow from '../ui/ProjectRow.astro';
---

<section
  class="platform-index container"
  id="tools"
  aria-labelledby="tools-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">The platform / 01—04</p><h2 id="tools-title">
        The research toolkit.
      </h2>
    </div><p class="section-aside">
      Different perspectives.<br />A more complete picture.
    </p>
  </div><div class="project-list">
    {projects.map((project) => <ProjectRow project={project} />)}
  </div><p class="index-caption mono">
    Research is connected. Analytical workspaces retain their current
    development status.
  </p>
</section>
