---
interface Props {
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---

<svg
  class:list={['arrow', { diagonal }]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  ><path
    d={diagonal ? 'M6 18 18 6M6 6h12v12' : 'M4 12h15m-6-6 6 6-6 6'}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></path></svg
>
