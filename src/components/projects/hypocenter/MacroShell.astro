---
import { getMacro } from '../../../lib/server/macro';
import { series, sparkline } from '../../../lib/macro/series';
const results = await getMacro();
const ready = results.filter((r) => r.status === 'ready').length;
const number = (n: number) =>
  n.toLocaleString('en-US', {
    maximumFractionDigits: 2,
    minimumFractionDigits: 2,
  });
---

<section class="macro-shell tool-workspace" aria-label="Economic conditions">
  <div class="workspace-heading">
    <h2>Economic conditions</h2><span class="mono muted"
      >{ready} / 4 SERIES AVAILABLE</span>
  </div>
  <p class="tool-help">
    Published observations from FRED, not real-time market quotes. Each series
    has its own reporting period and is subject to revision. Charts use
    independent vertical scales.
  </p>
  <div class="macro-grid">
    {
      series.map((item, i) => {
        const result = results[i],
          latest = result.observations.at(-1),
          previous = result.observations.at(-2);
        const points = result.observations.slice(
          item.frequency === 'Daily'
            ? -252
            : item.frequency === 'Quarterly'
              ? -20
              : -60,
        );
        return (
          <article class="macro-series">
            <>
              <p class="eyebrow">
                {item.category} / {item.frequency}
              </p>
              <h3>{item.label}</h3>
            </>
            {latest ? (
              <>
                <p class="macro-value">
                  {number(latest.value)}
                  <span>{item.unit}</span>
                </p>
                <p class="tool-help">
                  Observation: <time datetime={latest.date}>{latest.date}</time>
                  {previous && (
                    <>
                      {' '}
                      · {latest.value - previous.value >= 0 ? '+' : ''}
                      {number(latest.value - previous.value)} pp vs prior
                      observation
                    </>
                  )}
                </p>
                <svg
                  class="macro-chart"
                  viewBox="0 0 300 80"
                  role="img"
                  aria-label={`${item.label} trend, ${points[0].date} to ${latest.date}. Latest ${number(latest.value)} ${item.unit}.`}
                >
                  <polyline
                    points={sparkline(points)}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
                <div class="chart-dates mono muted">
                  <span>{points[0].date}</span>
                  <span>{latest.date}</span>
                </div>
                <details class="macro-history">
                  <summary>View observations</summary>
                  <div class="tool-table-scroll">
                    <table>
                      <caption>
                        Last 12 available observations · {item.unit}
                      </caption>
                      <thead>
                        <tr>
                          <th scope="col">Period</th>
                          <th scope="col">Value</th>
                        </tr>
                      </thead>
                      <tbody>
                        {result.observations
                          .slice(-12)
                          .reverse()
                          .map((p) => (
                            <tr>
                              <th scope="row">{p.date}</th>
                              <td>{number(p.value)}</td>
                            </tr>
                          ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              </>
            ) : (
              <div class="source-state">
                <h3>Source unavailable</h3>
                <p>
                  FRED could not be reached. No replacement values are shown.
                </p>
                <a href="/macro/" class="text-link">
                  Try again
                </a>
              </div>
            )}
            <>
              <p class="tool-help">{item.description}</p>
              <p class="macro-source">
                <a
                  class="text-link"
                  href={`https://fred.stlouisfed.org/series/${item.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.source} · {item.id} ↗
                </a>
              </p>
            </>
            <p class="mono muted">
              Checked{' '}
              {new Date(result.checkedAt)
                .toISOString()
                .replace('T', ' ')
                .slice(0, 16)}{' '}
              UTC
            </p>
          </article>
        );
      })
    }
  </div>
</section>
