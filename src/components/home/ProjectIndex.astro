---
import { projects } from '../../data/projects';
import ProjectRow from '../ui/ProjectRow.astro';

const toolkitProjects = projects
  .filter((project) => project.id !== 'nfa')
  .map((project, index) => ({
    ...project,
    number: String(index + 1).padStart(2, '0'),
  }));
---

<section
  class="platform-index container"
  id="tools"
  aria-labelledby="tools-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">The platform / 01—03</p><h2 id="tools-title">
        The research toolkit.
      </h2>
    </div><p class="section-aside">
      Different perspectives.<br />A more complete picture.
    </p>
  </div><div class="project-list">
    {toolkitProjects.map((project) => <ProjectRow project={project} />)}
  </div><p class="index-caption mono">
    Research is connected. Analytical workspaces retain their current
    development status.
  </p>
</section>
<script>
  const platform = document.querySelector<HTMLElement>('.platform-index');

  if (platform) {
    platform.dataset.motifMotion = '';

    const revealMotifs = () => {
      platform.dataset.motifsVisible = '';
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          revealMotifs();
          observer.disconnect();
        },
        { threshold: 0.28 },
      );
      observer.observe(platform);
    } else {
      revealMotifs();
    }
  }
</script>
