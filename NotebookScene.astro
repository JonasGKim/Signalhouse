<figure class="notebook-stage" data-notebook>
  <div
    class="desk-frame"
    data-replay-target
    role="button"
    tabindex="0"
    aria-label="Replay notebook animation"
  >
    <div class="desk-scene-label">
      <span><i></i> At the research desk</span><span data-scene-status
        >A question worth asking</span
      >
    </div>
    <svg
      class="desk-illustration"
      viewBox="0 0 720 600"
      role="img"
      aria-labelledby="desk-title desk-description"
    >
      <title id="desk-title">
        A little research, one pencil stroke at a time
      </title>
      <desc id="desk-description"
        >An illustrated researcher sits at a desk with an open notebook. A
        pencil underlines a question, checks three research steps, and comes to
        rest beside the completed page. Evidence and a reminder to question
        assumptions sit above the notebook.</desc
      >
      <defs>
        <linearGradient id="paper-fold" x1="0" x2="1"
          ><stop stop-color="#fdfaf1"></stop><stop
            offset=".85"
            stop-color="#fdfaf1"></stop><stop offset="1" stop-color="#e8e4d5"
          ></stop></linearGradient
        >
        <linearGradient id="paper-right" x1="0" x2="1"
          ><stop stop-color="#e8e4d5"></stop><stop
            offset=".12"
            stop-color="#fffcf4"></stop><stop offset="1" stop-color="#fffcf4"
          ></stop></linearGradient
        >
        <clipPath id="ink-reveal-0" clipPathUnits="userSpaceOnUse"
          ><rect data-ink-mask width="720" height="600"></rect></clipPath
        ><clipPath id="ink-reveal-1" clipPathUnits="userSpaceOnUse"
          ><rect data-ink-mask width="720" height="600"></rect></clipPath
        ><clipPath id="ink-reveal-2" clipPathUnits="userSpaceOnUse"
          ><rect data-ink-mask width="720" height="600"></rect></clipPath
        ><clipPath id="ink-reveal-3" clipPathUnits="userSpaceOnUse"
          ><rect data-ink-mask width="720" height="600"></rect></clipPath
        ><clipPath id="ink-reveal-4" clipPathUnits="userSpaceOnUse"
          ><rect data-ink-mask width="720" height="600"></rect></clipPath
        ></defs
      >
      <g
        stroke="#354237"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- Notes occupy their own area above the desk, away from the pages. -->
        <g transform="rotate(-5 124 160)">
          <rect
            x="38"
            y="81"
            width="166"
            height="158"
            rx="5"
            fill="#dedbce"
            stroke="none"
            transform="translate(3 5)"></rect>
          <rect x="38" y="81" width="166" height="158" rx="5" fill="#fffcf4"
          ></rect>
          <path d="M63 103h64" stroke="#b8b9a8" stroke-width="10" opacity=".5"
          ></path>
          <text x="56" y="136" class="desk-small-label"
            >START AT THE SOURCE</text
          >
          <path
            d="M56 159H183M56 177H176M56 195H181M56 213H150"
            stroke="#c3c6b7"
            stroke-width="2"></path>
          <path d="M55 175H166" stroke="#ddb676" stroke-width="10" opacity=".5"
          ></path>
          <path d="M55 176H167" stroke="#687960" stroke-width="1.5"></path>
        </g>
        <g
          class="question-card"
          data-replay-target
          transform="rotate(4 589 159)"
        >
          <path
            d="M494 85h177v157H494Z"
            fill="#d6c08c"
            stroke="none"
            transform="translate(3 5)"></path>
          <path
            d="M494 85h177v157H494Z"
            fill="#ecd39a"
            stroke="#bca56f"
            stroke-width="1.5"></path>
          <path d="M554 84h58" stroke="#d4cdb9" stroke-width="17" opacity=".8"
          ></path>
          <text x="515" y="128" class="desk-small-label">STAY CURIOUS.</text>
          <text x="515" y="163" class="desk-handwriting" font-size="24"
            ><tspan x="515">What would</tspan><tspan x="515" dy="29"
              >change</tspan
            ><tspan x="515" dy="29">my mind?</tspan></text
          >
        </g>
        <!-- Seated researcher: shoulders, collar, then head; the desk hides the torso. -->
        <path
          d="M257 300Q258 217 302 204L323 198H370L392 207Q438 221 441 300"
          fill="#758668"></path>
        <path d="M311 207L345 262L381 205" fill="#fffcf4"></path>
        <path d="M340 220h11l8 42-13 13-13-13Z" fill="#b77a58"></path>
        <path d="M323 184v22q22 16 43 0v-23" fill="#fffcf4"></path>
        <g data-researcher-head>
          <path
            d="M294 141q-17-10-15 9t18 17M397 140q15-9 14 10t-17 17"
            fill="#fffcf4"></path>
          <path
            d="M291 129Q287 86 341 82Q400 83 401 130L394 175Q383 202 347 204Q309 201 296 174Z"
            fill="#fffcf4"></path>
          <path
            d="M292 133Q280 100 302 88Q325 57 351 80Q384 73 398 99Q408 109 400 135L387 117Q341 130 307 110L299 135Z"
            fill="#354237"></path>
          <circle cx="322" cy="146" r="19" fill="#f3f0e5"></circle><circle
            cx="373"
            cy="146"
            r="19"
            fill="#f3f0e5"></circle>
          <path d="M341 146h13M293 138l10 5M392 143l7-4" fill="none"></path>
          <g data-eyes
            ><path d="M323 148v4M372 148v4" stroke-width="3.5"></path></g
          >
          <path
            d="M347 154l-4 12h8M336 183q12 6 23-2"
            fill="none"
            stroke-width="2"></path>
          <path d="M311 171h10M376 171h9" stroke="#dab49d" stroke-width="4"
          ></path>
        </g>
        <!-- A single contained desktop anchors every object. -->
        <rect
          x="26"
          y="276"
          width="668"
          height="294"
          rx="22"
          fill="#e8e5d8"
          stroke="#d4d2c3"
          stroke-width="1.5"></rect>
        <path d="M47 549H674" stroke="#d4d2c3" stroke-width="1"></path>
        <ellipse
          cx="352"
          cy="535"
          rx="263"
          ry="19"
          fill="#cfcebd"
          stroke="none"
          opacity=".6"></ellipse>
        <!-- Bound cover, page block and a continuous central gutter. -->
        <path
          d="M102 296Q224 276 352 298Q474 276 598 296L625 523Q489 507 352 537Q217 510 77 526Z"
          fill="#687b59"></path>
        <path
          d="M107 293Q230 275 352 297Q475 276 593 293L615 515Q482 502 352 528Q218 503 87 517Z"
          fill="#e7e3d4"
          stroke-width="1.5"></path>
        <path
          d="M111 287Q233 273 352 293L352 518Q226 491 92 506Z"
          fill="url(#paper-fold)"></path>
        <path
          d="M352 293Q473 273 589 287L610 506Q482 491 352 518Z"
          fill="url(#paper-right)"></path>
        <path d="M350 296v219" stroke="#bcbca9" stroke-width="1.2"></path>
        <path
          d="M352 293Q474 278 589 288M109 289Q233 279 350 295"
          stroke="#fffef8"
          stroke-width="2"
          fill="none"></path>
        <path d="M362 506l2 38 9-7 10 5-6-39" fill="#b77a58" stroke-width="1.5"
        ></path>
        <!-- Stationary page content is kept inside generous page margins. -->
        <text x="133" y="323" class="desk-small-label">FIELD NOTES / 001</text>
        <text x="132" y="362" class="desk-handwriting" font-size="29"
          ><tspan x="132">An idea worth</tspan><tspan x="132" dy="35"
            >looking into.</tspan
          ></text
        >
        <text x="130" y="447" class="desk-handwriting" font-size="19"
          ><tspan x="130">Less noise.</tspan><tspan x="130" dy="27"
            >More homework.</tspan
          ></text
        >
        <text x="386" y="323" class="desk-small-label">BEFORE CONVICTION</text>
        <g fill="none" stroke="#b0b5a4" stroke-width="1.5"
          ><rect x="386" y="353" width="19" height="19" rx="3"></rect><rect
            x="386"
            y="401"
            width="19"
            height="19"
            rx="3"></rect><rect x="386" y="449" width="19" height="19" rx="3"
          ></rect></g
        >
        <g class="desk-page-copy"
          ><text x="420" y="368">Read the source.</text><text x="420" y="416"
            >Test the thesis.</text
          ><text x="420" y="464">Name the risks.</text></g
        >
        <!-- Each continuous stroke is revealed at the pencil tip, never faded in. -->
        <g fill="none" stroke="#a96e48" stroke-width="2.6">
          <g clip-path="url(#ink-reveal-0)"
            ><path data-ink d="M132 409Q175 404 213 408T299 407"></path></g
          >
          <g clip-path="url(#ink-reveal-1)"
            ><path data-ink d="M388 361L395 368L408 351"></path></g
          >
          <g clip-path="url(#ink-reveal-2)"
            ><path data-ink d="M388 409L395 416L408 399"></path></g
          >
          <g clip-path="url(#ink-reveal-3)"
            ><path data-ink d="M388 457L395 464L408 447"></path></g
          >
          <g clip-path="url(#ink-reveal-4)"
            ><path data-ink d="M130 484Q187 480 265 485"></path></g
          >
        </g>
        <!-- Hands rest above the notebook's top edge, without covering its text. -->
        <path
          d="M282 283q-8-15-15-9l-5 17q-1 10 6 10h28q7-2 2-10l-7-10q-5-4-9 2Z"
          fill="#fffcf4"
          stroke-width="2"></path>
        <path
          d="M420 284q7-15 14-9l5 17q1 10-6 10h-27q-7-2-2-10l7-10q5-4 9 2Z"
          fill="#fffcf4"
          stroke-width="2"></path>
        <!-- Mug sits in a clear right-hand margin. -->
        <g transform="translate(645 316)"
          ><path d="M14 2q30-8 26 14q-4 13-25 11" fill="none" stroke-width="5"
          ></path><path d="M-21 0h42l-3 43q-17 10-35 0Z" fill="#b77a58"
          ></path><ellipse cy="0" rx="21" ry="7" fill="#fff9e9"
          ></ellipse><ellipse cy="1" rx="15" ry="3" fill="#70523e" stroke="none"
          ></ellipse></g
        >
        <!-- Pencil is modeled at its tip (0,0), so every movement shares the ink's coordinates. -->
        <g data-pencil transform="translate(648 520) rotate(16)">
          <g data-pencil-shadow opacity=".12" transform="translate(5 6)"
            ><path
              d="M0 0L-6-19V-91Q0-101 6-91V-19Z"
              fill="#354237"
              stroke="none"></path></g
          >
          <path d="M-6-20V-90H6V-20L0 0Z" fill="#e3b868" stroke-width="1.7"
          ></path>
          <path d="M-6-20L0 0L6-20Z" fill="#f5dfb2" stroke-width="1.5"></path>
          <path d="M-2-6L0 0L2-6" fill="#354237" stroke-width="1.5"></path>
          <path d="M-6-90v-7q6-5 12 0v7Z" fill="#b87b67" stroke-width="1.7"
          ></path>
          <path d="M-6-87H6" stroke="#a89676" stroke-width="5"></path>
          <path d="M0-25v-57" stroke="#fff0bc" stroke-width="2"></path>
        </g>
      </g>
    </svg>
  </div>
  <figcaption>
    <span>Curiosity → evidence → conviction</span><span class="replay-hint"
      >Click the desk to replay</span
    >
  </figcaption>
</figure>
<script>
  import { initializeNotebook } from '../../scripts/notebook-scene';
  initializeNotebook();
</script>
