---
import '@fontsource-variable/dm-sans';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import '../styles/notebook.css';
import '../styles/tools.css';
import Header from '../components/layout/Header.astro';
import ToolNav from '../components/layout/ToolNav.astro';
import Footer from '../components/layout/Footer.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Independent research, macroeconomic signals, valuation models, and tools for understanding public companies.',
} = Astro.props;
const fullTitle = title
  ? `${title} — Signalhouse`
  : 'Signalhouse — Independent financial research & software';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} /><meta
      name="theme-color"
      content="#f6f6f2"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site)}
    />
    <meta property="og:title" content={fullTitle} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" />
    <title>{fullTitle}</title>
  </head>
  <body
    class:list={{
      'home-page': Astro.url.pathname === '/',
      'tool-page': ['/macro/', '/valuation/', '/filings/'].some((path) =>
        Astro.url.pathname.startsWith(path),
      ),
    }}
    ><a class="skip-link" href="#main">Skip to content</a><Header /><main
      id="main"
    >
      {
        ['/macro/', '/valuation/', '/filings/'].some((p) =>
          Astro.url.pathname.startsWith(p),
        ) && <ToolNav />
      }
      <slot />
    </main><Footer /></body
  >
</html>
