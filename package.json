{
  "name": "signalhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro check && astro build && node scripts/prepare-hosting.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:routes": "node scripts/verify-routes.mjs",
    "build:vercel": "DEPLOY_TARGET=vercel npm run build",
    "lint": "astro check",
    "build:sites": "DEPLOY_TARGET=cloudflare npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/vercel": "11.0.10",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@notionhq/client": "^5.26.0",
    "astro": "7.3.2",
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "sharp": "0.35.4"
  }
}
