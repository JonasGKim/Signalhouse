# Server-only Notion credentials for Vercel. Use .dev.vars for Cloudflare locally.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Production origin, without a trailing slash. Otherwise uses Vercel's production hostname.
SITE_URL=
# Optional server-only end-of-day market quotes. Never prefix this with PUBLIC_.
ALPHA_VANTAGE_API_KEY=
